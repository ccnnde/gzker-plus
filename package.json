{
  "name": "gzker-plus",
  "version": "1.7.0",
  "private": true,
  "description": "过早客论坛增强插件～",
  "repository": {
    "type": "git",
    "url": "https://github.com/ccnnde/gzker-plus.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Nor Cod",
    "email": "norfecod@outlook.com"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm type-check && wxt build",
    "build:ff": "pnpm type-check && wxt build -b firefox",
    "clean:dist": "rimraf dist",
    "clean:node": "rimraf node_modules",
    "clean:wxt": "wxt clean",
    "dev": "wxt",
    "dev:ff": "wxt -b firefox",
    "format": "prettier --write .",
    "git:push": "node git-push.cjs",
    "git:release": "changelogen gh release",
    "postinstall": "wxt prepare",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.vue,.json",
    "lint:fix": "pnpm lint --fix",
    "lint:list": "DEBUG=eslint:cli-engine pnpm lint",
    "log:auto": "pnpm log:gen && pnpm log:format && pnpm log:stage",
    "log:format": "prettier --write src/markdown/ChangeLog.md package.json",
    "log:gen": "changelogen --bump --clean",
    "log:stage": "git add src/markdown/ChangeLog.md package.json",
    "prepare": "husky",
    "styl-lint": "stylelint **/*.{scss,vue}",
    "styl-lint:fix": "stylelint **/*.{scss,vue} --fix",
    "styl-lint:list": "pnpm styl-lint -f verbose",
    "type-check": "vue-tsc --noEmit",
    "up-all": "pnpm up --latest",
    "zip": "wxt zip",
    "zip:ff": "wxt zip -b firefox"
  },
  "dependencies": {
    "@unocss/reset": "0.65.4",
    "@vueuse/core": "10.11.1",
    "cherry-markdown": "0.8.39",
    "element-plus": "2.4.2",
    "emoji-mart-vue-fast": "15.0.0",
    "html-entities": "2.5.2",
    "js-cookie": "3.0.5",
    "localforage": "1.10.0",
    "lodash-es": "4.17.21",
    "markdown-it-github-alerts": "0.3.0",
    "markdown-it-link-attributes": "4.0.1",
    "markdown-it-task-checkbox": "1.0.6",
    "mitt": "3.0.1",
    "nanoid": "5.0.7",
    "pinia": "2.1.7",
    "qrcode.vue": "3.4.1",
    "scroll-into-view-if-needed": "3.1.0",
    "v-viewer": "3.0.11",
    "viewerjs": "1.11.6",
    "vue": "3.3.8",
    "vue-i18n": "11.4.10",
    "vue-router": "4.2.5"
  },
  "devDependencies": {
    "@babel/core": "7.23.3",
    "@babel/eslint-parser": "7.23.3",
    "@commitlint/cli": "17.6.5",
    "@iconify-json/mdi": "1.1.55",
    "@intlify/unplugin-vue-i18n": "11.2.5",
    "@types/js-cookie": "3.0.6",
    "@types/lodash-es": "4.17.11",
    "@types/webextension-polyfill": "0.10.6",
    "@typescript-eslint/eslint-plugin": "5.59.9",
    "@typescript-eslint/parser": "5.59.9",
    "@unocss/eslint-config": "0.65.4",
    "@unocss/eslint-plugin": "0.65.4",
    "@vue/eslint-config-typescript": "12.0.0",
    "@wxt-dev/module-vue": "1.0.3",
    "@wxt-dev/unocss": "1.0.1",
    "@wxt-dev/webextension-polyfill": "1.0.0",
    "changelogen": "0.5.5",
    "commitlint-config-git-commit-emoji": "1.0.0",
    "eslint": "8.57.1",
    "eslint-config-alloy": "5.1.2",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "2.29.0",
    "eslint-plugin-jsonc": "2.10.0",
    "eslint-plugin-simple-import-sort": "10.0.0",
    "eslint-plugin-vue": "9.18.1",
    "husky": "9.1.7",
    "jsonc-eslint-parser": "2.0.4",
    "lint-staged": "13.2.2",
    "magicast": "0.3.5",
    "postcss-html": "1.5.0",
    "prettier": "2.8.8",
    "prettier-plugin-packagejson": "2.4.6",
    "rimraf": "5.0.5",
    "sass": "1.69.5",
    "stylelint": "15.11.0",
    "stylelint-config-recess-order": "4.3.0",
    "stylelint-config-standard-scss": "11.1.0",
    "stylelint-config-standard-vue": "1.0.0",
    "typescript": "5.7.3",
    "unocss": "0.65.4",
    "unplugin-vue-components": "28.8.0",
    "unplugin-vue-markdown": "28.3.1",
    "vite": "^6.3.4",
    "vue-eslint-parser": "9.3.2",
    "vue-tsc": "2.2.12",
    "web-ext": "9.2.0",
    "webextension-polyfill": "0.10.0",
    "wxt": "0.21.4"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.18.1",
    "pnpm": "11.20.0"
  }
}
